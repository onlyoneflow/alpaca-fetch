{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "none", "width": 26, "height": 13 },
  "display": {
    "separator": " 󰁔 ",
    "key": { "type": "icon", "paddingLeft": 1 },
    "color": { "keys": "blue", "output": "white", "separator": "blue" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "os", "host", "kernel", "uptime", "cpu", "memory", "disk", "shell", "terminal"
  ]
}
