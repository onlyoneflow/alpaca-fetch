{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "none", "width": 26, "height": 13 },
  "display": {
    "separator": "  󰁔  ",
    "key": { "type": "icon", "paddingLeft": 2 },
    "color": { "keys": "#B87333", "title": "#F0C38E", "output": "#F3D7B5", "separator": "#8B5E3C" }
  },
  "modules": [
    { "type": "title", "key": "  ✦", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "{#8B5E3C}  ────────  ✦  ALPACA DEN  ✦  ────────{#}" },
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "{#C48A5A}  ◈  SYSTEM{#}" },
    "os", "host", "kernel", "uptime",
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "{#C48A5A}  ◈  HARDWARE{#}" },
    "cpu", "memory", "disk",
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "{#C48A5A}  ◈  SESSION{#}" },
    "shell", "terminal"
  ]
}
