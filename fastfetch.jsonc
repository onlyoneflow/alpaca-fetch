{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "none", "width": 28, "height": 15 },
  "display": {
    "separator": " 󰁔 ",
    "key": { "type": "icon", "paddingLeft": 1 },
    "color": { "keys": "#B87333", "title": "#F0C38E", "output": "#F3D7B5", "separator": "#8B5E3C" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "os", "host", "kernel", "uptime", "cpu", "memory", "disk", "shell", "terminal"
  ]
}
