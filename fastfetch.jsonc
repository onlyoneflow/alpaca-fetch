{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "width": 26, "height": 13, "position": "left" },
  "display": {
    "separator": " 󰁔 ",
    "key": { "type": "icon", "paddingLeft": 1 },
    "color": { "keys": "blue", "output": "white", "separator": "blue" },
    "bar": { "width": 10 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "{#4}────────────────────────────────{#}" },
    "os", "host", "kernel", "uptime",
    { "type": "separator", "string": "" },
    "cpu", "gpu", "memory", "disk", "battery",
    { "type": "separator", "string": "" },
    "shell", "terminal", "packages"
  ]
}
